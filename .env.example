# .env.example — copy to .env and fill in values

# Neon Postgres: pooled connection (used by Prisma at runtime via PgBouncer)
# Host must contain "-pooler". Query parameters should include connect_timeout=15&pool_timeout=20 for serverless resilience.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=20"

# Neon Postgres: direct connection (used by Prisma Migrate / db push)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# App URL for metadata base and sitemap generation
NEXT_PUBLIC_APP_URL="https://oneatlas.dev"

# OpenRouter API key (optional — public endpoints work without it, but rate limits apply)
# OPENROUTER_API_KEY="sk-or-..."
